<?xml version="1.0" encoding="UTF-8"?>
<executable>
  <category>HistomicsTK</category>
  <title>IFTA Segmentation</title>
  <description>For segmenting peritubular capillaries in PAS-stained WSIs</description>
  <version>0.2.0</version>
  <documentation-url>https://digitalslidearchive.github.io/HistomicsTK/</documentation-url>
  <license>Apache 2.0</license>
  <contributor>Anish Tatke (UFL)</contributor>
  <acknowledgements>This work is part of efforts in digital pathology by the Sarder Lab: UFL.</acknowledgements>
  <parameters>
    <label>IO</label>
    <description>Input/output parameters.</description>
    <image reference="_girder_id_">
      <name>input_file</name>
      <label>Input Image</label>
      <description>Input Image</description>
      <channel>input</channel>
      <index>0</index>
    </image>
    <integer>
      <name>boxSizeHR</name>
      <label>boxSizeHR</label>
      <description> size of high resolution blocks</description>
      <default>3000</default>
      <channel>input</channel>
      <index>1</index>
    </integer>
    <double>
      <name>overlap_percentHR</name>
      <label>overlap_percentHR</label>
      <description>overlap percentage of high resolution blocks [0-1]</description>
      <default>0.5</default>
      <channel>input</channel>
      <index>2</index>
    </double>
    <directory>
      <name>model</name>
      <label>model directory</label>
      <description>model directory</description>
      <channel>input</channel>
      <index>3</index>
    </directory>
    <string>
      <name>output_annotation_name</name>
      <label>Annotation Name</label>
      <description>Name for the output annotation</description>
      <default>ifta</default>
      <channel>input</channel>
      <index>4</index>
    </string>
  </parameters>
  <parameters advanced="true">
    <label>Advanced</label>
    <description>Advanced parameters for performance tuning.</description>
    <integer>
      <name>batch_size</name>
      <label>Batch Size</label>
      <description>Number of image tiles processed per GPU call. Higher values are faster but use more GPU memory. Recommended: 2 for 24GB GPU with 3000px tiles.</description>
      <default>2</default>
      <channel>input</channel>
      <index>5</index>
    </integer>
  </parameters>
  <parameters advanced="true">
    <label>Girder API URL and Key</label>
    <description>A Girder API URL and token for Girder client</description>
    <string>
      <name>girderApiUrl</name>
      <longflag>api-url</longflag>
      <label>Girder API URL</label>
      <description>A Girder API URL (e.g., https://girder.example.com:443/api/v1)</description>
      <default></default>
    </string>
    <string>
      <name>girderToken</name>
      <longflag>token</longflag>
      <label>Girder API Token</label>
      <description>A Girder token</description>
      <default></default>
    </string>
  </parameters>
</executable>
